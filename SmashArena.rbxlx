	theme = { clock = 14, ambient = C(140, 150, 180), backdrop = C(110, 170, 235), fog = C(170, 210, 255) },
	spawns = { V(-20, 4, 0), V(20, 4, 0), V(-8, 4, 0), V(8, 4, 0), V(-17, 16, 0), V(17, 16, 0) },
