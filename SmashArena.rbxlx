local M = Enum.Material

local Maps = {}

Maps[1] = {
	name = "Temple du Ciel",
	desc = "Classique : une scène et 3 plateformes",
	icon = C(120, 200, 255),
	blast = { x = 95, top = 85, bottom = 60 },
