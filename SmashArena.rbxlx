		{ kind = "platform", size = V(14, 1, 10), pos = V(0, 23, 0), color = C(255, 220, 120), material = M.SmoothPlastic },
		{ kind = "deco", size = V(3, 30, 3), pos = V(-40, -10, -30), color = C(240, 240, 250), material = M.Marble },
		{ kind = "deco", size = V(3, 30, 3), pos = V(40, -10, -30), color = C(240, 240, 250), material = M.Marble },
